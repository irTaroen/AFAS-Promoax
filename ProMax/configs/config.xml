<configuration>
  <!-- MODE: TEST = AFAS test-omgeving (resttest.afas.online), PROD = productie (rest.afas.online) -->
  <mode>TEST</mode>
  <!-- Flow-schakelaars (true/false). Ontbrekend => aan.
       flow1 = AFAS Forecasts -> Salesbuildr Opportunities
       flow2 = Gesloten Salesbuildr Opportunities -> AFAS Voorcalculatie -->
  <flows>
    <flow1>true</flow1>
    <flow2>true</flow2>
  </flows>
  <global>
    <NotifySmtpServer>smtp.promax.lan</NotifySmtpServer>
    <NotifyEmail>robert.glintmeijer@promax.nl</NotifyEmail>
  </global>
  <afas>
    <omgeving>53307</omgeving>
    <!-- AFAS API-token: het volledige <token>…</token> XML (plaintext).
         De scripts base64-encoderen dit zelf tot de 'AfasToken …' Authorization-header. -->
    <token><![CDATA[<token><version>1</AFAS OKEN HERE</data></token>]]></token>
    <connectors>
      <forecasts_get>Salesbuildr_Forecasts</forecasts_get>
      <forecasts_update>CmForecast</forecasts_update>
      <artikelen_get>Salesbuildr_Artikelen</artikelen_get>
      <artikelen_update>FbItemArticle</artikelen_update>
      <voorcalculatie_get>Salesbuildr_Voorcalculatie</voorcalculatie_get>
      <voorcalculatie_update>KnQuotation</voorcalculatie_update>
    </connectors>
  </afas>
  <salesbuildr>
    <url>https://verkoop.promax.nl</url>
    <apikey>SB TOKEN HERE</apikey>
    <!-- SB-hoofdcategorie 'Diensten': regels hieronder hebben geen mpn en worden via
         het product-veld internalProductId naar AFAS herleid (werksoort als het in AFAS
         bestaat, anders een TXT-regel). Ontbreekt deze waarde => val terug op de bekende id. -->
    <diensten_maincategory_id>UyOpp42UPGy3LKgSOQGX</diensten_maincategory_id>
  </salesbuildr>
</configuration>
